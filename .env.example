# Resend (https://resend.com) — used by /api/inquiry to send the internal
# notification + submitter confirmation for the Start a Project form.
# Requires a verified sending domain for the FROM_ADDRESS in that route.
RESEND_API_KEY=

# Sanity (https://sanity.io) — content source for case studies, verticals,
# and disciplines. Both values are publishable; the dataset is public-read.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
